<Page x:Class="XboxGamingBrowser.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="using:Microsoft.UI.Xaml.Controls" Background="#10151E">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="8" Padding="10" Background="#182231">
   <Button Content="‹" FontSize="24" Click="Back_Click"/><Button Content="›" FontSize="24" Click="Forward_Click"/><Button Content="⌂" FontSize="24" Click="Home_Click"/>
   <ComboBox x:Name="SearchEngine" Width="128" SelectedIndex="0" AutomationProperties.Name="Motor de búsqueda">
    <ComboBoxItem Content="Google" Tag="https://www.google.com/search?q="/>
    <ComboBoxItem Content="Bing" Tag="https://www.bing.com/search?q="/>
    <ComboBoxItem Content="DuckDuckGo" Tag="https://duckduckgo.com/?q="/>
   </ComboBox>
   <TextBox x:Name="Address" Width="440" PlaceholderText="URL o búsqueda con Google" KeyDown="Address_KeyDown"/>
   <Button Content="IR" Click="Go_Click"/><Button Content="MODO GAMING" Click="Gaming_Click"/><Button Content="Pruebas" Click="Diagnostics_Click"/><Button Content="Memoria" Click="Memory_Click"/><Button Content="−" Click="ZoomOut_Click"/><Button Content="+" Click="ZoomIn_Click"/>
  </StackPanel>
  <Grid Grid.Row="1"><wv2:WebView2 x:Name="Browser" IsHitTestVisible="True" IsTabStop="True" PointerPressed="Browser_PointerPressed" NavigationStarting="Browser_NavigationStarting" NavigationCompleted="Browser_NavigationCompleted"/><Button x:Name="ExitGaming" Content="Volver al navegador" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed" Click="Gaming_Click"/></Grid>
 </Grid>
</Page>
