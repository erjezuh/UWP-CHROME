<Page x:Class="XboxGamingBrowser.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="using:Microsoft.UI.Xaml.Controls" Background="#10151E">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="Toolbar" Orientation="Vertical" Spacing="6" Padding="10" Background="#182231">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Content="‹" Width="48" FontSize="24" Click="Back_Click"/><Button Content="›" Width="48" FontSize="24" Click="Forward_Click"/><Button Content="⌂" Width="48" FontSize="24" Click="Home_Click"/>
    <ComboBox x:Name="SearchEngine" Width="138" SelectedIndex="0" AutomationProperties.Name="Motor de búsqueda">
     <ComboBoxItem Content="Google" Tag="https://www.google.com/search?q="/>
     <ComboBoxItem Content="Bing" Tag="https://www.bing.com/search?q="/>
     <ComboBoxItem Content="DuckDuckGo" Tag="https://duckduckgo.com/?q="/>
    </ComboBox>
    <TextBox x:Name="Address" Width="500" PlaceholderText="URL o búsqueda con Google" KeyDown="Address_KeyDown"/>
    <Button Content="IR" Width="72" Click="Go_Click"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Content="MODO GAMING" Width="160" Click="Gaming_Click"/>
    <Button Content="Pruebas" Width="120" Click="Diagnostics_Click"/>
    <Button Content="Memoria" Width="120" Click="Memory_Click"/>
    <Button Content="−" Width="60" FontSize="22" Click="ZoomOut_Click"/>
    <Button Content="+" Width="60" FontSize="22" Click="ZoomIn_Click"/>
   </StackPanel>
  </StackPanel>
  <Grid Grid.Row="1"><wv2:WebView2 x:Name="Browser" IsHitTestVisible="True" IsTabStop="True" PointerPressed="Browser_PointerPressed" NavigationStarting="Browser_NavigationStarting" NavigationCompleted="Browser_NavigationCompleted"/><Button x:Name="ExitGaming" Content="Volver al navegador" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed" Click="Gaming_Click"/></Grid>
 </Grid>
</Page>
